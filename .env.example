# Copy to .env and adjust for your machine/robot, then run with:
#   docker run --network host --env-file .env go2 bridge

# DDS network interface connected to the Go2's subnet (192.168.123.x).
# Check with `ip link show`; common values are eno1, eth0, wlan0.
GO2_NETWORK_INTERFACE=eth0

# Only needed if GO2_NETWORK_INTERFACE has more than one IPv4 address (e.g. a
# shared test-bench NIC with one address per robot) — CycloneDDS otherwise
# binds to whichever address it enumerates first, which may not be the
# robot's subnet, causing DDS discovery to fail silently.
# GO2_NETWORK_ADDRESS=192.168.123.50

# Reference only — not read by any code (DDS discovery is multicast-based,
# ChannelFactoryInitialize() only takes the interface name above). Useful for
# `ping`-ing the robot while troubleshooting; find it via
# `ip neigh show dev <interface>` if it's not the commonly assumed 192.168.123.1.
# GO2_ROBOT_IP=192.168.123.1

# Host/ports the bridge listens on and clients (CLI/web app/MCP) connect to.
# With --network host these all share the host's loopback, so "localhost"
# works even when bridge/webapp/cli run in separate containers.
GO2_BRIDGE_HOST=localhost
GO2_ZMQ_CMD_PORT=5555
GO2_ZMQ_PUB_PORT=5556

GO2_MOVE_HZ=20
GO2_MOVE_TIMEOUT_MS=250
GO2_CAMERA_FPS=10
GO2_OBSTACLE_AVOIDANCE=1

GO2_WEBAPP_HOST=0.0.0.0
GO2_WEBAPP_PORT=8080
